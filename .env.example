APP_NAME=AstraTrack
# PRODUCTION: set APP_ENV=production and APP_DEBUG=false (debug pages show code paths and stack traces),
# serve over HTTPS and set SESSION_SECURE_COOKIE=true.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ID recognition: "idanalyzer" (ID Analyzer API) or "gemini"
IDENTITY_READER=idanalyzer
IDANALYZER_API_KEY=
# A preset (security_low / security_medium / security_high) or your KYC profile ID from the ID Analyzer portal
IDANALYZER_PROFILE=security_medium
# "docupass" = live ID + selfie check on ID Analyzer's hosted page (needs your own KYC profile ID above,
# with its Redirect URL set to APP_URL/client/identity/live/return); "upload" = photo upload only
IDENTITY_METHOD=docupass
# Webhook signing secret from the KYC profile (Profile > General); leave empty until the site has a public HTTPS URL
IDANALYZER_WEBHOOK_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=astratrack
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
# "database" runs slow work (Gemini ID reading, SMS/email) in a worker: php artisan queue:work --timeout=200
# "sync" runs it inline during the request (no worker needed, but uploads wait ~30 s).
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=240
MAIL_MAILER=log

# Email notifications: set MAIL_MAILER=smtp and fill these (e.g. Gmail: smtp.gmail.com, 587, an app password)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="AstraTrack"
MAIL_TIMEOUT=10

# SMS notifications: SMS_DRIVER=log writes SMS to storage/logs instead of sending; set to semaphore to send
SMS_DRIVER=log
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
FILESYSTEM_DISK=local

SESSION_COOKIE=ASTRASESSID
# true in production (HTTPS only), so the session cookie is never sent over plain HTTP
SESSION_SECURE_COOKIE=false


# WhatsApp Cloud API (Meta). Token from developers.facebook.com > WhatsApp > API Setup (temporary tokens expire in ~24h)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v25.0
# off = SMS only, log = write to log, meta = send. SMS is the backup when WhatsApp fails.
WHATSAPP_DRIVER=off
# Your approved template; set HAS_MESSAGE=true when its body has one {{1}} for the update text
WHATSAPP_TEMPLATE=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_HAS_MESSAGE=false
